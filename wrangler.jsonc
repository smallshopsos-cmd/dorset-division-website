{
  "name": "dorset-division-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  // Preview policy pages without connecting to production data or sending email.
  "previews": {
    "vars": {
      "CONTACT_DELIVERY_ENABLED": "false"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [{ "binding": "REVIEWS_DB", "database_name": "dorset-division-reviews", "database_id": "a955a662-9c9f-4031-b596-09c12da07550" }],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "762609521",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
